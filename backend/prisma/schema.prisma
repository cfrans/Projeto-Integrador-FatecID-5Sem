generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Guardian {
  id                 String              @id @default(uuid()) @db.Char(36)
  email              String              @unique @db.VarChar(254)
  name               String              @db.VarChar(100)
  passwordHash       String              @db.VarChar(255)
  securityQuestion   String?             @db.VarChar(255)
  securityAnswerHash String?             @db.VarChar(255)
  devices            Device[]
  associations       DeviceAssociation[]
  pairingSessions    PairingSession[]
}

model Device {
  id                             String                 @id @default(uuid()) @db.Char(36)
  name                           String                 @db.VarChar(100)
  managedUser                    String?                @db.VarChar(100)
  guardianId                     String?                @db.Char(36)
  isDemo                         Boolean                @default(true)
  guardian                       Guardian?              @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  applicationsReportedAt         DateTime?              @db.DateTime(3)
  installationRequestsReportedAt DateTime?              @db.DateTime(3)
  applications                   InstalledApplication[]
  installationRequests           InstallationRequest[]
  agentReports                   AgentReport[]
  agentIdentity                  AgentIdentity?
  pairingSessions                PairingSession[]
  associations                   DeviceAssociation[]    @relation("AssociationDevice")

  commands AgentCommand[]

  @@index([guardianId])
}

model AgentIdentity {
  id              String         @id @default(uuid()) @db.Char(36)
  deviceId        String         @unique @db.Char(36)
  credentialHash  String         @unique @db.Char(64)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  revokedAt       DateTime?      @db.DateTime(3)
  device          Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  claimedCommands AgentCommand[]
}

model PairingSession {
  id                         String    @id @default(uuid()) @db.Char(36)
  deviceId                   String?   @db.Char(36)
  registrationDeviceId       String?   @db.Char(36)
  registrationCredentialHash String?   @db.Char(64)
  registrationName           String?   @db.VarChar(100)
  registrationManagedUser    String?   @db.VarChar(100)
  tokenHash                  String    @unique @db.Char(64)
  createdAt                  DateTime  @default(now()) @db.DateTime(3)
  expiresAt                  DateTime  @db.DateTime(3)
  consumedAt                 DateTime? @db.DateTime(3)
  revokedAt                  DateTime? @db.DateTime(3)
  consumedByGuardianId       String?   @db.Char(36)
  device                     Device?   @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumedByGuardian         Guardian? @relation(fields: [consumedByGuardianId], references: [id], onDelete: SetNull)

  @@index([deviceId, expiresAt])
  @@index([registrationCredentialHash])
}

model DeviceAssociation {
  id             String           @id @default(uuid()) @db.Char(36)
  deviceId       String           @db.Char(36)
  guardianId     String           @db.Char(36)
  activeDeviceId String?          @unique @db.Char(36)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  revokedAt      DateTime?        @db.DateTime(3)
  device         Device           @relation("AssociationDevice", fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guardian       Guardian         @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  simulation     SimulationState?

  commands AgentCommand[]

  @@index([deviceId, createdAt])
  @@index([guardianId, revokedAt])
}

model SimulationState {
  associationId   String            @id @db.Char(36)
  settings        Json
  revision        Int               @default(1)
  appliedRevision Int?
  appliedAt       DateTime?         @db.DateTime(3)
  lastSeenAt      DateTime?         @db.DateTime(3)
  association     DeviceAssociation @relation(fields: [associationId], references: [id], onDelete: Cascade)
}

model InstalledApplication {
  id       String  @id @default(uuid()) @db.Char(36)
  deviceId String  @db.Char(36)
  sourceId String  @db.VarChar(191)
  name     String  @db.VarChar(200)
  category String  @db.VarChar(100)
  allowed  Boolean
  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, sourceId])
  @@index([deviceId, name])
}

enum InstallationRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model InstallationRequest {
  id              String                    @id @default(uuid()) @db.Char(36)
  deviceId        String                    @db.Char(36)
  sourceId        String                    @db.VarChar(191)
  applicationName String                    @db.VarChar(200)
  requesterName   String                    @db.VarChar(100)
  requestedAt     DateTime                  @db.DateTime(3)
  ageRating       String                    @db.VarChar(20)
  status          InstallationRequestStatus @default(PENDING)
  device          Device                    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, sourceId])
  @@index([deviceId, status, requestedAt])
}

model AgentReport {
  id                        String   @id @default(uuid()) @db.Char(36)
  deviceId                  String   @db.Char(36)
  reportId                  String   @db.Char(36)
  contentHash               String   @db.Char(64)
  collectedAt               DateTime @db.DateTime(3)
  receivedAt                DateTime @default(now()) @db.DateTime(3)
  applicationsCount         Int
  installationRequestsCount Int
  device                    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, reportId])
  @@index([deviceId, receivedAt])
}

enum CommandStatus {
  pending
  running
  succeeded
  failed
  expired
  cancelled
  unknown
}

model AgentCommand {
  id                  String            @id @default(uuid()) @db.Char(36)
  deviceId            String            @db.Char(36)
  associationId       String            @db.Char(36)
  requestId           String            @db.Char(36)
  type                String            @db.VarChar(32)
  version             Int
  parameters          Json
  status              CommandStatus     @default(pending)
  createdAt           DateTime          @default(now()) @db.DateTime(3)
  expiresAt           DateTime          @db.DateTime(3)
  claimId             String?           @db.Char(36)
  claimedByIdentityId String?           @db.Char(36)
  claimedAt           DateTime?         @db.DateTime(3)
  executionDeadlineAt DateTime?         @db.DateTime(3)
  result              Json?
  errorCode           String?           @db.VarChar(32)
  completedAt         DateTime?         @db.DateTime(3)
  device              Device            @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  association         DeviceAssociation @relation(fields: [associationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  claimedByIdentity   AgentIdentity?    @relation(fields: [claimedByIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([associationId, requestId])
  @@unique([deviceId, claimId])
  @@index([deviceId, status, createdAt, id])
}
