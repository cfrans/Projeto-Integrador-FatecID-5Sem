NODE_ENV=development
MYSQL_DATABASE=piplup
MYSQL_USER=piplup_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
PORT=3000
JWT_SECRET=
DEV_GUARDIAN_EMAIL=
DEV_GUARDIAN_NAME=
DEV_GUARDIAN_PASSWORD=

# Habilita a criação de comandos parentais; o Lux Agent atual só executa agent.ping.
ENABLE_PARENTAL_COMMANDS=false
