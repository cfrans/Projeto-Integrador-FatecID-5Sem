# Written by install.sh to /etc/lux-agent/agent.env (root, 0600).
# HTTPS origin of the Piplup backend. Do not use the development loopback URL in production.
LUX_AGENT_BACKEND_URL=https://api.example.invalid
# Standard (non-sudo) child account managed by this computer. Chosen locally, never by the backend.
LUX_AGENT_MANAGED_USER=crianca
# Extra poll options, e.g. --ca-file /etc/lux-agent/ca.pem for the development CA.
LUX_AGENT_POLL_OPTIONS=
